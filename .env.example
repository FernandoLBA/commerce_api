# ===========================================
# Commerce API - Environment Variables
# ===========================================

# ===========================================
# Base de datos PostgreSQL (requerido)
# ===========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/commerce_db?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=commerce_db

# ===========================================
# Entorno de la aplicación
# ===========================================
NODE_ENV=development
PORT=3000

# ===========================================
# JWT Authentication (requerido)
# ===========================================
# IMPORTANTE: Cambiar en producción por una clave segura de al menos 32 caracteres
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Seguridad - CORS
# ===========================================
# Orígenes permitidos separados por coma (sin espacios)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# ===========================================
# Seguridad - Rate Limiting
# ===========================================
# Configuración global (requests por minuto)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Configuración para autenticación (más estricta)
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=5

# Configuración para endpoints de creación
THROTTLE_CREATE_TTL=60000
THROTTLE_CREATE_LIMIT=30

# API Key interna (para saltar throttling en servicios internos)
INTERNAL_API_KEY=your_internal_api_key_change_in_production

# ===========================================
# Servicios Externos (opcional)
# ===========================================

# Stripe - Pagos con tarjeta
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MercadoPago - Pagos
# Obtén tu token en: https://www.mercadopago.com/developers
MERCADOPAGO_ACCESS_TOKEN=TEST-...

# Cloudinary - Almacenamiento de imágenes
# Configura en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email SMTP - Notificaciones
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM="E-commerce <noreply@example.com>"
